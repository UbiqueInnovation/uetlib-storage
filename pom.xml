<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.uetlib</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.11.2</version>
        <relativePath/>
    </parent>

    <artifactId>uetlib-storage</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>uetlib-storage</name>
    <description>Storage abstractions and client implementations.</description>
    <url>https://github.com/UbiqueInnovation/uetlib-storage</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <name>Ubique Innovation AG</name>
        <url>https://www.ubique.ch</url>
    </organization>
    <developers>
        <developer>
            <name>Ubique Innovation AG</name>
            <organization>Ubique Innovation AG</organization>
            <organizationUrl>https://www.ubique.ch</organizationUrl>
        </developer>
    </developers>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-testcontainers</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-test</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-webp</artifactId>
                <version>1.0.3</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-core</artifactId>
                <version>3.0.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- uetlib modules -->
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-webp</artifactId>
        </dependency>

        <!-- External storage clients -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3-transfer-manager</artifactId>
        </dependency>

        <!-- Http client used by AWS S3 SDK -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>netty-nio-client</artifactId>
        </dependency>

        <!-- Necessary for minio with okhttp5 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>

        <!-- Reflections -->
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>



    <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false">
        <connection>scm:git:https://github.com/UbiqueInnovation/uetlib-storage.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/UbiqueInnovation/uetlib-storage.git</developerConnection>
        <url>https://github.com/UbiqueInnovation/uetlib-storage</url>
    </scm>
</project>