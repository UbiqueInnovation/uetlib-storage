<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.2.2</version>
    </parent>

    <artifactId>uetlib-storage</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <uetlib-core.version>2.0.1</uetlib-core.version>
        <uetlib-test.version>2.0.0</uetlib-test.version>
        <uetlib-testcontainers.version>2.0.0</uetlib-testcontainers.version>
    </properties>

    <dependencies>
        <!-- uetlib modules -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-core</artifactId>
            <version>${uetlib-core.version}</version>
        </dependency>

        <!-- External storage clients -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3-transfer-manager</artifactId>
        </dependency>

        <!-- Http client used by AWS S3 SDK -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>netty-nio-client</artifactId>
        </dependency>

        <!-- Necessary for minio with okhttp5 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>

        <!-- Reflections -->
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-test</artifactId>
            <version>${uetlib-test.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers</artifactId>
            <version>${uetlib-testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>osgeo</id>
            <name>Open Source Geospatial Foundation Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
    </repositories>

    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/UbiqueInnovation/uetlib-storage</url>
    </scm>
</project>